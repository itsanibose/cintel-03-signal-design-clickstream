      "code_hash": "76c166754eb903be273868c75b032f57",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h1 id=\"signal-design-clickstream-sessions\">Signal Design: Clickstream Sessions</h1>\n<span class=\"paragraph\">Raw clickstream events (<code>event_time</code>, <code>event_type</code>, <code>product_id</code>,\n<code>category_id</code>, <code>category_code</code>, <code>brand</code>, <code>price</code>, <code>user_id</code>,\n<code>user_session</code>) are hard to read one row at a time. This app groups\nevents into <strong>sessions</strong> and derives signals that tell a clearer story:</span>\n<ul>\n<li><strong>Activity:</strong> <code>total_events</code>, <code>views</code>, <code>carts</code>, <code>remove_from_carts</code>,\n  <code>purchases</code>, <code>session_duration_sec</code></li>\n<li><strong>Funnel ratios:</strong> <code>cart_to_view_ratio</code>, <code>purchase_to_cart_ratio</code>,\n  <code>session_conversion_rate</code></li>\n<li><strong>Problem flag:</strong> <code>abandoned_cart</code> (carted but never purchased)</li>\n</ul>\n<span class=\"paragraph\">Pick a signal below to see the sessions where it is highest.</span></span>"
          }
        }
      ],
      "console": []
    },
